<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    显式声明包源：这台机器上的机器级 NuGet 配置没有任何源，不写这一份的话
    新拉一台机器 restore 会直接 NU1100。清空继承来的源，只认 nuget.org。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
