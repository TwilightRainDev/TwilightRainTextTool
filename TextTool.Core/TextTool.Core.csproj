<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TextTool</RootNamespace>
    <AssemblyName>TextTool.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="default_schemes.json" />
    <EmbeddedResource Include="default_vn_schemes.json" />
    <EmbeddedResource Include="default_lint_rules.json" />
    <!-- TLS 固定锚点：公共根 CA SPKI 白名单（certifi 生成，见 doc/UpdateSecurity.md） -->
    <EmbeddedResource Include="pinned_roots.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试需断言 store 的嵌入式资源名常量，使其在查询串写错时真正失败 -->
    <InternalsVisibleTo Include="TextTool.Tests" />
  </ItemGroup>

</Project>
