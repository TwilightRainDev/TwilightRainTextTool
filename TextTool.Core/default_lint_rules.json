  {
    "Id": "doc-process-residue",
    "Group": "syntax",
    "Title": "文档里的过程残留",
    "Kind": "regex",
    "Patterns": [
      "(?:第[一二三四五六七八九十\\d]+阶段|阶段[一二三四五六七八九十\\d]+)[^。！？\\n]{0,12}(?:完成|新增|实现|加(?:了|上)|做完|开发完|补齐|补充)",
