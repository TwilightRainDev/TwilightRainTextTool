<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    控件外观只在这里定义。FluentTheme 自带的状态色（悬停、按下）会把按钮刷回主题色，
    所以主操作按钮必须在 pointerover / pressed 上显式覆盖模板里的 ContentPresenter，
    否则深色主题下悬停时会闪出一块浅灰。
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
  </Style>

  <!--
    FluentTheme 的页签头用的是 24 DIP 的 WinUI 式大字号，还附带 48 的最小高度。
    六个页签在这个字号下装不进 760 DIP 的窗口，会折成两行。这里改回正文字号。
  -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,6" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource ControlBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MutedFg}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource ControlBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource ControlBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <Style Selector="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <!-- 默认按钮是次要样式，主操作用 Classes="primary" 反转配色。 -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource ControlBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MutedFg}" />
    <Setter Property="Padding" Value="14,5" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource ActionBg}" />
    <Setter Property="Foreground" Value="{DynamicResource ActionFg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ActionBg}" />
    <Setter Property="Padding" Value="22,7" />
  </Style>

  <!-- 悬停和按下必须显式覆盖，否则 FluentTheme 会拿它自己的状态色，
       深色主题下主操作按钮一悬停就闪出一块浅灰。 -->
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ActionBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ActionBg}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ActionFg}" />
  </Style>

  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ActionBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ActionBg}" />
  </Style>

  <!-- 禁用态也要留住按钮轮廓：只剩一行灰字的话，用户看不出那里有个按钮。 -->
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MutedFg}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedFg}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="BorderBrush" Value="{DynamicResource MutedFg}" />
  </Style>

  <!--
    勾选项的文字是用 TextBlock 做内容的（为了能换行），而下面那条全局
    TextBlock 样式会把 Foreground 刷成正文色，把勾选框上的语义色盖掉。
    所以带语义色的勾选框必须同时指定内容里的 TextBlock。
  -->
  <Style Selector="CheckBox.danger">
    <Setter Property="Foreground" Value="{DynamicResource WarningFg}" />
  </Style>

  <Style Selector="CheckBox.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningFg}" />
  </Style>

  <Style Selector="CheckBox.secondary">
    <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
  </Style>

  <Style Selector="CheckBox.secondary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
  </Style>

</Styles>
