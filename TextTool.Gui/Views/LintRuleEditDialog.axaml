<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TextTool.Gui.Views.LintRuleEditDialog"
        Title="{DynamicResource DlgLintRuleEdit}"
        Width="640" Height="700"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <!-- Avalonia 11.2 的 Grid 没有行间距属性，间距给在直接子控件上。 -->
    <Style Selector="Grid > TextBlock, Grid > TextBox, Grid > Button, Grid > StackPanel, Grid > ComboBox, Grid > CheckBox">
      <Setter Property="Margin" Value="0,0,10,8" />
    </Style>
  </Window.Styles>

  <!--
    单条规则的编辑窗，由 AI 味检查页的规则侧栏打开。骨架与方案编辑窗一致：
    左标签右输入、行内警告、右下角取消与确定，不放规则列表（列表在侧栏上）。
    改动写进程序目录的 lint_rules.json，只存改过的条目。
  -->
  <Grid Margin="12" RowDefinitions="Auto,*,Auto">

    <!-- 保存失败时的醒目提示：整行横条，不靠系统弹窗 -->
    <Border x:Name="BannerBar" Grid.Row="0"
            IsVisible="False" BorderThickness="1" Padding="10,6" Margin="0,0,0,8"
            CornerRadius="3"
            BorderBrush="{DynamicResource WarningFg}"
            Background="{DynamicResource StatusBg}">
      <TextBlock x:Name="BannerText" TextWrapping="Wrap"
                 Foreground="{DynamicResource WarningFg}" />
    </Border>

    <ScrollViewer Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <TextBlock x:Name="TitleLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" />

        <TextBlock x:Name="KindLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
        <ComboBox x:Name="KindBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                  HorizontalAlignment="Stretch" SelectedIndex="0">
          <ComboBoxItem x:Name="KindLiteralItem" />
          <ComboBoxItem x:Name="KindRegexItem" />
          <!-- 由代码计算的规则只走这一项，而且下拉框置灰：改它等于换一段代码算 -->
          <ComboBoxItem x:Name="KindAlgorithmItem" />
        </ComboBox>

        <TextBlock x:Name="GenresLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
        <!-- 标签列宽随译文变长，一行放不下时排到第二行，不出右边边界 -->
        <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
          <CheckBox x:Name="GenreDocBox" Margin="0,0,12,0" />
          <CheckBox x:Name="GenreFictionBox" Margin="0,0,12,0" />
          <CheckBox x:Name="GenreAgentBox" Margin="0,0,12,0" />
        </WrapPanel>

        <TextBlock x:Name="SeverityLabel" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" />
        <ComboBox x:Name="SeverityBox" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"
                  HorizontalAlignment="Stretch" SelectedIndex="0">
          <ComboBoxItem x:Name="SeverityInfoItem" />
          <ComboBoxItem x:Name="SeverityWarnItem" />
        </ComboBox>

        <TextBlock x:Name="MinCountLabel" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox x:Name="MinCountBox" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                 Width="90" HorizontalAlignment="Left" />

        <TextBlock x:Name="PatternsLabel" Grid.Row="5" Grid.Column="0" VerticalAlignment="Top"
                   Margin="0,8,10,8" />
        <!-- 词表本体：一行一条。规则长了在自己框里滚，不把窗口撑高。 -->
        <TextBox x:Name="PatternsBox" Grid.Row="5" Grid.Column="1"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="210"
                 FontFamily="Consolas, Menlo, monospace"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <!-- 由代码计算的规则没有词表可编：词表框隐去，这一行显示说明 -->
        <TextBlock x:Name="AlgorithmHintLabel" Grid.Row="5" Grid.Column="1"
                   VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,8,10,8" IsVisible="False" />

        <TextBlock x:Name="DefaultOffLabel" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" />
        <CheckBox x:Name="DefaultOffBox" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" />

        <TextBlock x:Name="DetailLabel" Grid.Row="7" Grid.Column="0" VerticalAlignment="Top" />
        <TextBox x:Name="DetailBox" Grid.Row="7" Grid.Column="1"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" />

      </Grid>
    </ScrollViewer>

    <!-- 操作行：左边是恢复，右边是取消与确定；行内提示在下 -->
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,10,0,0">

      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button x:Name="RestoreButton" Click="OnRestore" />
          <Button x:Name="RestoreAllButton" Click="OnRestoreAll" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelButton" Click="OnCancel" />
          <Button x:Name="OkButton" Classes="primary" Click="OnOk" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Spacing="4" Margin="0,8,0,0">
        <TextBlock x:Name="StateLabel" Classes="muted" TextWrapping="Wrap" />
        <TextBlock x:Name="WarningLabel" TextWrapping="Wrap" IsVisible="False"
                   Foreground="{DynamicResource WarningFg}" />
        <TextBlock x:Name="HintLabel" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

    </Grid>

  </Grid>

</Window>
