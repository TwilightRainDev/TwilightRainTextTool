<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:TextTool.Gui.Localization"
        xmlns:views="using:TextTool.Gui.Views"
        x:Class="TextTool.Gui.Views.MainWindow"
        Title="{DynamicResource AppTitle}"
        Width="760" Height="560"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- 状态栏 -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource StatusBg}"
            BorderBrush="{DynamicResource ControlBg}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <TextBlock x:Name="StatusText" Text="{DynamicResource StatusReady}" Classes="muted" />
    </Border>

    <TabControl x:Name="Tabs" Margin="8">

      <TabItem Header="{DynamicResource TabMerge}">
        <views:MergeTab x:Name="MergeTabView" />
      </TabItem>

      <TabItem Header="{DynamicResource TabJoin}">
        <TextBlock Text="{DynamicResource TabJoin}" Classes="placeholder"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </TabItem>

      <TabItem Header="{DynamicResource TabReplace}">
        <views:ReplaceTab x:Name="ReplaceTabView" />
      </TabItem>

      <TabItem Header="{DynamicResource TabVN}">
        <TextBlock Text="{DynamicResource TabVN}" Classes="placeholder"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </TabItem>

      <TabItem Header="{DynamicResource TabLint}">
        <TextBlock Text="{DynamicResource TabLint}" Classes="placeholder"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </TabItem>

      <TabItem Header="{DynamicResource TabAbout}">
        <StackPanel Orientation="Vertical" Margin="16" Spacing="12">

          <Button x:Name="DarkModeButton" Content="{DynamicResource BtnDarkMode}"
                  HorizontalAlignment="Left" Click="OnToggleTheme" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{DynamicResource LabelLanguage}" VerticalAlignment="Center" />
            <ComboBox x:Name="LanguageCombo" MinWidth="140">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="loc:LanguageOption">
                  <TextBlock Text="{Binding Display}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

        </StackPanel>
      </TabItem>

    </TabControl>

  </DockPanel>

</Window>
