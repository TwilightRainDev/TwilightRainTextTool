<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TextTool.Gui.Views"
        x:Class="TextTool.Gui.Views.MainWindow"
        Title="{DynamicResource AppTitle}"
        Icon="avares://TextTool.Gui/Assets/icon.png"
        Width="760" Height="560"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- 状态栏 -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource StatusBg}"
            BorderBrush="{DynamicResource ControlBg}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <TextBlock x:Name="StatusText" Text="{DynamicResource StatusReady}" Classes="muted" />
    </Border>

    <TabControl x:Name="Tabs" Margin="8">

      <TabItem Header="{DynamicResource TabMerge}">
        <views:MergeTab x:Name="MergeTabView" />
      </TabItem>

      <TabItem Header="{DynamicResource TabJoin}">
        <views:JoinTab x:Name="JoinTabView" />
      </TabItem>

      <TabItem Header="{DynamicResource TabReplace}">
        <views:ReplaceTab x:Name="ReplaceTabView" />
      </TabItem>

      <TabItem Header="{DynamicResource TabVN}">
        <views:VnTab x:Name="VnTabView" />
      </TabItem>

      <TabItem Header="{DynamicResource TabLint}">
        <views:LintTab x:Name="LintTabView" />
      </TabItem>

      <TabItem Header="{DynamicResource TabAbout}">
        <views:AboutTab x:Name="AboutTabView" />
      </TabItem>

    </TabControl>

  </DockPanel>

</Window>
