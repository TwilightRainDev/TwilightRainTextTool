<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <!-- 依赖框架部署：用户需自行安装 .NET 8 运行时 -->
    <!-- 下载地址：https://dotnet.microsoft.com/download/dotnet/8.0 -->
    <SelfContained>false</SelfContained>
    <!-- 版本号统一在 Directory.Build.props 中管理 -->
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <Authors>TwilightRain</Authors>
    <Company>TwilightRain</Company>
    <AssemblyTitle>TwilightRain的文本工具</AssemblyTitle>
    <RepositoryUrl>https://github.com/TwilightRainDev/TextTool</RepositoryUrl>
  </PropertyGroup>

  <!-- 排除同级测试项目的源码文件，防止 SDK 自动 glob 误包含 -->
  <ItemGroup>
    <Compile Remove="TextTool.Tests\**" />
    <EmbeddedResource Remove="TextTool.Tests\**" />
    <Compile Remove="TextTool.Core\**" />
    <EmbeddedResource Remove="TextTool.Core\**" />
    <Compile Remove="TextTool.Cli\**" />
    <EmbeddedResource Remove="TextTool.Cli\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="TextTool.Core\TextTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>